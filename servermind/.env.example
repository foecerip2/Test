# ServerMind — пример конфигурации. Только плейсхолдеры. Реальный .env не коммитить.

# --- web ---
# Включает dev-фикстуры (ТОЛЬКО локальная разработка). Всегда показывает ribbon «Демо-данные».
NEXT_PUBLIC_DEV_FIXTURES=0
# Куда Next проксирует /api/v1/* (значение читается при СБОРКЕ web)
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=https://app.servermind.example

# --- api ---
ENVIRONMENT=production                             # development включает /api/docs
DATABASE_URL=postgresql+psycopg://servermind:CHANGE_ME@postgres:5432/servermind
ENCRYPTION_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES    # обязателен; base64 от 32 случайных байт; хранить вне БД и git (secret file)
COOKIE_SECURE=true                                 # false только для http-разработки
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
ALLOW_PRIVATE_TARGETS=false                        # true — только в отдельном тестовом окружении администратора (SSRF-политика)
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15
SSH_OPS_PER_MINUTE=10
OUTPUT_CAP_BYTES=65536
EXECUTION_ENABLED=false                            # kill switch мутаций (Фаза 4)
MAX_CONCURRENT_EXECUTIONS=1
PLATFORM_AI_KEY=                                   # ключ платформы для режима Credits; пусто = Credits недоступны

# --- политика ресурсов ---
DISK_WARN_PERCENT=75
DISK_BLOCK_PERCENT=90
