# SERVERMIND_SITE_ADDRESS:
#   app.example.com — автоматический HTTPS (нужна A-запись и свободные порты 80/443);
#   :80             — режим без HTTPS (только для теста по IP; тогда COOKIE_SECURE=false).
{
	admin off
}

{$SERVERMIND_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	request_body {
		max_size 2MB
	}

	# Весь трафик — в Next.js; /api/v1/* он проксирует в API (API наружу напрямую не опубликован)
	reverse_proxy web:3000
}
