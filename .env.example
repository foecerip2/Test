# Пример для сервера: /opt/leadhunter/.env (права 0600, НЕ коммитить реальные значения).
# Большая часть значений создаётся автоматически: install.sh / `lh-config init`; почта и владелец — `lh-config mail-relay|smtp|owner`.
# Знак $ в значениях для compose нужно удваивать ($$) — lh-config делает это сам.
DOMAIN=ai.vaylonet.ru
PUBLIC_ORIGIN=https://ai.vaylonet.ru

# База данных (сервис db в compose; порт наружу не публикуется)
POSTGRES_PASSWORD=
# Драйвер должен совпадать с зависимостями apps/api
DATABASE_URL=postgresql+psycopg://leadhunter:<POSTGRES_PASSWORD>@db:5432/leadhunter

# API (ENV=prod задаётся в compose)
SECRET_KEY=            # >= 32 символов, генерируется: openssl rand -hex 32
COOKIE_SECURE=true
OWNER_EMAIL=           # lh-config owner you@example.com

# Почта для кодов входа. В prod: http (HTTPS-ретранслятор на хостинге Рег.ру, основной) или smtp.
# Пока почта не настроена, API отвечает 503 MAIL_UNAVAILABLE. Настройка: `lh-config mail-relay`.
MAIL_BACKEND=http      # http | smtp
MAIL_RELAY_URL=https://vaylonet.ru/lh-mail.php
MAIL_RELAY_SECRET=     # >= 32 символов; генерирует `lh-config mail-relay` (не в чат)
# Прямой SMTP — запасной вариант для серверов без блокировки портов (`lh-config smtp`):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=         # только через `lh-config smtp` (не в чат)
SMTP_FROM=
SMTP_SECURITY=ssl      # ssl | starttls | none

# Необязательный шлюз basic-auth перед всем сайтом: пусто = выключен (по умолчанию).
# Включение: `lh-config gate on`. Хэш в .env с удвоенными $$.
BASIC_USER=owner
BASIC_HASH=

# Заполняется службой lh-update автоматически
WEB_IMAGE=
API_IMAGE=
COMPOSE_PROFILES=      # api — когда в коммите есть apps/api/Dockerfile
