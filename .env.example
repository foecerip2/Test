# Пример для сервера: /opt/leadhunter/.env (права 0600, НЕ коммитить реальные значения)
DOMAIN=ai.vaylonet.ru
# Временная защита до появления реальной аутентификации (Фаза 2).
# Хэш: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'ПАРОЛЬ'
# В .env символы $ в хэше нужно удваивать: $$2a$$14$$...
BASIC_USER=owner
BASIC_HASH=
# Заполняется деплоем автоматически (образ по digest)
WEB_IMAGE=
